module Sieve [level=3]

import B := Benchmark

type
  Sieve = record end

procedure sieve(flags: pointer to array of boolean; size: integer): integer
var primeCount, i, k: integer
begin
    primeCount := 0

    for i := 2 to size do
        if flags[i - 1] then
            inc(primeCount)
            k := i + i
            while k <= size do
                flags[k - 1] := false
                k := k + i
            end
        end
    end
    return primeCount
end sieve

procedure Sieve.benchmark(): integer
const count = 5000
var i, res: integer
	flags: pointer to array of boolean
begin
    new(flags, count)
    for i := 0 to count - 1 do
        flags[i] := true
    end
    res := sieve(flags, count)
    dispose(flags)
    return res
end benchmark

procedure Sieve.verifyResult(result: integer): boolean
begin
    return 669 = result
end verifyResult

procedure Sieve.release()
begin
    dispose(self)
end release

procedure Sieve.innerBenchmarkLoop(innerIterations: integer): boolean
begin
    return B.innerBenchmarkLoop(self, innerIterations)
end innerBenchmarkLoop

procedure create*(): B.Benchmark
var bench: ^Sieve
begin
    new(bench)
    return bench
end create

end Sieve
