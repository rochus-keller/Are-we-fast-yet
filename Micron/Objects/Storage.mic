module Storage [level=4]

import R := som.Random, B := Benchmark

type
	Storage* = object(B.Benchmark)
	  count: integer
  	end
  StoragePtr* = pointer to Storage

	TreeArray = record
	  arr: pointer to TreeArrayArray
	  len: uint32
	end
	
	TreeArrayArray = array of TreeArray

procedure TreeArray.deinit()
var i: integer; t: TreeArray
begin
    for i := 0 to self.len-1 do
    	t := self.arr[i]
        t.deinit()
    end
    if self.arr # nil then dispose(self.arr) end 
    self.len := 0
    self.arr := nil
end deinit

procedure Storage.buildTreeDepth(depth: integer): TreeArray
var res: TreeArray; i: integer
begin
    inc(self.count)
    if depth = 1 then
        res.len := R.next() mod 10 + 1
        new(res.arr, res.len)
        for i := 0 to res.len-1 do
            res.arr[i].len := 0
            res.arr[i].arr := nil
        end
        return res
    else
        res.len := 4
        new(res.arr, res.len)
        for i := 0 to res.len-1 do
            res.arr[i] := self.buildTreeDepth(depth - 1)
        end
        return res
    end
end buildTreeDepth

procedure Storage.benchmark(): integer
var arr: TreeArray
begin
    R.reset()
    self.count := 0
    arr := self.buildTreeDepth(7)
    arr.deinit()
    return self.count
end benchmark

procedure Storage.verifyResult(result: integer): boolean
begin
  return 5461 = result
end verifyResult

procedure create*(): B.BenchmarkPtr
var s: StoragePtr
begin
    new(s)
    return s
end create

end Storage
