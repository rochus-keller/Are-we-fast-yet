module Interfaces(T) [level=4]

type
	ForEach* = object end
	ForEachPtr* = pointer to ForEach

	Collect* = object end
	CollectPtr* = pointer to Collect

	Test* = object end
	TestPtr* = pointer to Test

	Comparator* = object end
	ComparatorPtr* = pointer to Comparator

procedure ForEach.apply*(const elem: ^T)
begin
end apply

procedure Collect.collect*(const o: ^T): ^T
begin
	return nil
end collect

procedure Test.test*(const elem: ^T): boolean
begin
	return false
end test

procedure Comparator.compare*(const lhs, rhs: ^T): integer
begin
	return 0
end compare

end Interfaces
