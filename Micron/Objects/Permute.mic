module Permute [level=4]
 
import B := Benchmark

type 
	Permute* = object(B.Benchmark)
				count: integer
				v: pointer to array of integer
			end
	PermutePtr* = pointer to Permute
			
	proc Permute.swap(i,j: integer)
	var tmp: integer
	begin
		tmp := self.v[i]
		self.v[i] := self.v[j]
		self.v[j] := tmp
	end swap
	
	proc Permute.permute(n: integer)
	var n1, i: integer
	begin
		inc(self.count)
		if n # 0 then
		    n1 := n - 1
		    self.permute(n1)
		    for i := n1 to 0 by -1 do
		        self.swap(n1, i)
		        self.permute(n1)
		        self.swap(n1, i)
		    end
		end
    end permute
    
    proc Permute.benchmark(): integer
	begin
		self.count := 0
		new(self.v, 6)
		self.permute(6)
		dispose(self.v)
		return self.count
	end benchmark
	
	proc Permute.verifyResult(result: integer): boolean
	begin
  		return result = 8660
	end verifyResult

	proc create*(): B.BenchmarkPtr
	var per: PermutePtr
	begin
		new(per)
		return per
   	end create

 end Permute
